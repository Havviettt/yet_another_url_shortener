      "targets": [{"expr": "url_shortener_urls_created", "legendFormat": "created", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Redirects completed",
      "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "url_shortener_redirects_completed", "legendFormat": "redirects", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Validation errors",
      "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "url_shortener_validation_errors", "legendFormat": "validation", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Not found",
      "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "url_shortener_not_found", "legendFormat": "not found", "refId": "A"}]
